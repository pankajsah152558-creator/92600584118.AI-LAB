def is_safe(board, row, col, n):
    # Check the column
    for i in range(row):
        if board[i] == col:
            return False

    # Check upper-left diagonal
    for i in range(row):
        if board[i] - i == col - row:
            return False

    # Check upper-right diagonal
    for i in range(row):
        if board[i] + i == col + row:
            return False

    return True


def solve_n_queens(board, row, n):
    # All queens placed
    if row == n:
        return True

    for col in range(n):
        if is_safe(board, row, col, n):
            board[row] = col

            if solve_n_queens(board, row + 1, n):
                return True

            # Backtrack
            board[row] = -1

    return False


def print_board(board, n):
    for row in range(n):
        for col in range(n):
            if board[row] == col:
                print("Q", end=" ")
            else:
                print(".", end=" ")
        print()


# Main program
n = int(input("Enter number of queens: "))

board = [-1] * n

if solve_n_queens(board, 0, n):
    print("\nSolution:")
    print_board(board, n)
else:
    print("No solution exists.")
